# ─── Truckeroo Nigeria — PRODUCTION env template ────────────────────────────
# Copy to .env on the production server and fill in the real secrets.
# Country/Currency DECISION: Nigeria (NGN). Use a Nigerian Flutterwave account.

FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=CHANGE_ME_LONG_RANDOM
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM

# Database (production MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=negoride
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
# DB_SOCKET= (leave unset on Linux/production)

# ─── Flutterwave (NIGERIA — NGN) ────────────────────────────────────────────
# IMPORTANT: these MUST be from a Nigerian (NGN) Flutterwave account, otherwise
# NGN charges are rejected. Keep secret/encryption keys server-side only.
FLW_SECRET_KEY=FLWSECK-CHANGE_ME-X
FLW_PUBLIC_KEY=FLWPUBK-CHANGE_ME-X
FLW_ENCRYPTION_KEY=CHANGE_ME
# FLW_SECRET_HASH must EXACTLY match the hash you set on the Flutterwave
# dashboard webhook config; the backend rejects webhooks that don't match.
FLW_SECRET_HASH=CHANGE_ME_WEBHOOK_HASH
FLW_BASE_URL=https://api.flutterwave.com
FLW_CURRENCY=NGN
FLW_PAYMENT_OPTIONS=card,banktransfer,ussd
FLW_TIMEOUT=30

# Driver subscription fee revenue share (percent kept by platform from per-trip
# in-app payments, if any). Subscription itself is full platform revenue.
SERVICE_FEE_PERCENTAGE=10

# Shared secret for the subscription-expiry cron (POST /api/subscriptions/expire,
# header: X-Cron-Secret). Generate a random value.
SUBSCRIPTION_CRON_SECRET=CHANGE_ME_RANDOM

# Push notifications
ONESIGNAL_APP_ID=CHANGE_ME
ONESIGNAL_REST_API_KEY=CHANGE_ME

# App URL (used for Flutterwave redirect/callback + logos)
APP_URL=https://truckeroo.mruodel.com
SERVER_PORT=5001

# Mail (verification / password reset)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_NAME=Truckeroo
MAIL_FROM_ADDRESS=no-reply@truckeroo.com

# ─── Cron suggestion (crontab) ──────────────────────────────────────────────
# Expire lapsed subscriptions + take those drivers offline, every 10 minutes:
#   */10 * * * * curl -s -X POST https://truckeroo.mruodel.com/api/subscriptions/expire \
#       -H "X-Cron-Secret: $SUBSCRIPTION_CRON_SECRET" >/dev/null 2>&1
